fn main() -> i32
{
    let ggs = getGetSub;
    let gs = ggs();
    let s: fn(i32, i32)->i32 = gs();

    demo_types();

    let a = s(10, 1); // 9
    let b = sub(b: 10, a: 30); // 20
    let c = apply(sub, b, a); // 11
    let d = sub(a: c, 1); // 10

    return d;
}

fn sub(a: i32, b: i32) -> i32
{
    return a - b;
}

fn getSub() -> fn(i32, i32) -> i32
{
    return sub;
}

fn getGetSub() -> fn() -> fn(i32, i32) -> i32
{
    return getSub;
}

fn apply(f: fn(i32,i32)->i32, a: i32, b: i32) -> i32
{
    let result = f(a, b);
    return result;
}

fn demo_types()
{
    demo_int();
    demo_bool();
    demo_float();
}

fn demo_int()
{
    let test_a: i16 = 123;
    let test_b = test_a + 123;
    123 + test_a;
    let test_c: i16 = 100000;
    let test_d = 5;
    let test_e: i16 = 1 + 2;
    let test_f: i16 = test_a + 100000;
    let test_g: i64 = 3000000000;
    let test_h = 5 as i8;
}

fn demo_bool()
{
    let test_a: bool = true;
    let test_b: bool = false;
    let test_c = !test_a;
    let test_d = 5 == 6;
    let test_e = 5 >= 6;
}

fn demo_float()
{
    let test_f32: f32 = 5.123 + 5.1;
    let test_f64: f64 = 5.123 + 5.1;
    let test_a = 5.123 + test_f32;
    let test_b = 5.123 + test_f64;
    let test_c = 5e123;
}