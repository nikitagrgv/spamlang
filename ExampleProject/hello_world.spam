fn main() -> i32
{
    let ggs = getGetSub;
    let gs = ggs();
    let s: fn(i32, i32)->i32 = gs();

    demo_types();

    let a = s(10, 1); // 9
    let b = sub(b: 10, a: 30); // 20
    let c = apply(sub, b, a); // 11
    let d = sub(a: c, 1); // 10

    return d;
}

fn sub(a: i32, b: i32) -> i32
{
    return a - b;
}

fn getSub() -> fn(i32, i32) -> i32
{
    return sub;
}

fn getGetSub() -> fn() -> fn(i32, i32) -> i32
{
    return getSub;
}

fn apply(f: fn(i32,i32)->i32, a: i32, b: i32) -> i32
{
    let result = f(a, b);
    return result;
}

fn demo_types()
{
    let test_a: i16 = 123;
    let test_b = test_a + 123;
    123 + test_a;
    let test_c: i16 = 100000;
    let test_d = 5;
    let test_e: i16 = 1 + 2;
    let test_f: i16 = test_a + 100000;
    let test_g: i64 = 3000000000;
    let test_h = 5 as i8;
    let test_i: bool = true;
    let test_j: bool = false;
    let test_k: !test_j;
    let test_l = 5 == 6;
    let test_m = 5 >= 6;
    let test_n: f32 = 5.123f + 5.1F;
    let test_o: f64 = 5.123;
    let test_p = 5.123f + test_o;
    let test_r = 5e123;
}